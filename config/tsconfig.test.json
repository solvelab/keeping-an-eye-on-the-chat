{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist-tests",
    "rootDir": "..",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "declaration": false,
    "declarationMap": false,
    "allowJs": true
  },
  "include": [
    "../tests/**/*",
    "../src/config/**/*",
    "../src/shared/**/*",
    "../src/main/**/*",
    "../src/renderer/scripts/**/*",
    "../src/renderer/config/scripts/**/*",
    "../src/preload/**/*",
    "../scripts/**/*.js"
  ]
}
